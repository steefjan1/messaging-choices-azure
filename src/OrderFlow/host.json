{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request;Trace"
      }
    },
    "logLevel": {
      "OrderFlow": "Information"
    }
  },
  "extensions": {
    "queues": {
      "maxDequeueCount": 3,
      "visibilityTimeout": "00:00:10",
      "batchSize": 8
    },
    "serviceBus": {
      "maxConcurrentCalls": 8,
      "maxConcurrentSessions": 4
    },
    "eventHubs": {
      "maxEventBatchSize": 100,
      "batchCheckpointFrequency": 1,
      "initialOffsetOptions": {
        "type": "fromStart"
      }
    }
  }
}
